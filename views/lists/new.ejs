<%- include('../partials/header', { title: 'Create List' }) %>

<%- include('../partials/pageHeader', {
  title: 'Create List',
  subtitle: 'Create a new list from an existing template.',
  crumbs: [['/lists', 'Lists'], ['', 'New']],
}) %>

<div class="row">
  <div class="col-lg-8 col-xl-7">
    <%- include('../partials/errors', { errors }) %>

    <% if (templates.length === 0) { %>
      <div class="alert alert-warning">
        There are no templates yet. <a href="/templates/new" class="alert-link">Create a template first.</a>
      </div>
    <% } else { %>
      <% const mine = templates.filter((t) => t.is_mine); %>
      <% const starters = templates.filter((t) => !t.is_mine && t.is_starter); %>
      <% const others = templates.filter((t) => !t.is_mine && !t.is_starter); %>
      <div class="card">
        <div class="card-body p-4">
          <form action="/lists" method="POST">
            <div class="mb-3">
              <label for="name" class="form-label">List Name <span class="text-primary">*</span></label>
              <input id="name" name="name" class="form-control" value="<%= values.name %>" required maxlength="100" placeholder="Office Appointments">
            </div>
            <div class="mb-3">
              <label for="templateId" class="form-label">Template <span class="text-primary">*</span></label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-stack" aria-hidden="true"></i></span>
                <select id="templateId" name="templateId" class="form-select" required aria-describedby="template-help">
                  <option value="">Pick a template</option>
                  <% [['Your templates', mine], ['Starter templates', starters], ["Other people's templates", others]].forEach(([groupLabel, group]) => { %>
                    <% if (group.length) { %>
                      <optgroup label="<%= groupLabel %>">
                        <% group.forEach((t) => { %>
                          <option value="<%= t.template_id %>" <%= String(t.template_id) === values.templateId ? 'selected' : '' %>>
                            <%= t.name %><%= t.is_mine || t.is_starter ? '' : ` (by ${t.username})` %>
                          </option>
                        <% }); %>
                      </optgroup>
                    <% } %>
                  <% }); %>
                </select>
              </div>
              <div id="template-help" class="form-text">
                Every entry in the list must follow this template's rules.
                <% if (mine.length === 0) { %>You can also <a href="/templates/new">make your own template</a>.<% } %>
              </div>
            </div>
            <div class="mb-4">
              <label for="description" class="form-label">Description <span class="text-body-secondary">(optional)</span></label>
              <textarea id="description" name="description" class="form-control" rows="3" maxlength="500"
                        placeholder="List of office appointments with contact details."><%= values.description %></textarea>
            </div>
            <div class="d-flex justify-content-end gap-2">
              <a class="btn btn-outline-secondary" href="/lists">Cancel</a>
              <button type="submit" class="btn btn-primary">Create List</button>
            </div>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
