<%- include('partials/header', { title: 'Sign in', bare: true }) %>

<div class="row g-0 min-vh-100">
  <%- include('partials/authHero') %>
  <div class="col-lg-6 d-flex align-items-center justify-content-center p-4">
    <div class="w-100" style="max-width: 26rem">
      <a href="/" class="d-lg-none d-flex align-items-center gap-2 text-decoration-none text-body fs-4 fw-bold mb-4">
        <i class="bi bi-layers-fill text-primary" aria-hidden="true"></i> ListForge
      </a>
      <div class="card shadow">
        <div class="card-body p-4 p-md-5">
          <h2 class="h3 fw-bold mb-1">Sign In</h2>
          <p class="text-body-secondary mb-4">Access your workspace</p>

          <%- include('partials/errors', { errors }) %>

          <form action="/login" method="POST">
            <div class="mb-3">
              <label for="identifier" class="form-label">Username or email</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                <input id="identifier" name="identifier" class="form-control" value="<%= values.identifier || '' %>" required autocomplete="username">
              </div>
            </div>
            <div class="mb-4">
              <label for="password" class="form-label">Password</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                <input id="password" name="password" type="password" class="form-control" required autocomplete="current-password">
                <button class="btn btn-outline-secondary" type="button" data-toggle-password="password" aria-label="Show password">
                  <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">Sign In</button>
          </form>
          <p class="text-center small mt-4 mb-0">Don't have an account? <a href="/signup">Create Account</a></p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/showPassword') %>
<%- include('partials/footer', { bare: true }) %>
