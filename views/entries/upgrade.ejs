<%- include('../partials/header', { title: `Update old entries | ${list.name}` }) %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/lists">Lists</a></li>
    <li class="breadcrumb-item"><a href="/lists/<%= list.list_id %>"><%= list.name %></a></li>
    <li class="breadcrumb-item active" aria-current="page">Update old entries</li>
  </ol>
</nav>

<h1 class="h2 mb-3">Apply the new rules to existing entries</h1>

<% if (oldEntries.length === 0) { %>
  <div class="alert alert-success">All entries already follow version <%= list.version_number %> of the template.</div>
  <a class="btn btn-outline-secondary" href="/lists/<%= list.list_id %>">Back to the list</a>
<% } else { %>
  <p class="lead">
    <%= oldEntries.length %> <%= oldEntries.length === 1 ? 'entry was' : 'entries were' %> saved under an older version.
    Every entry that passes version <%= list.version_number %>'s rules will be moved to it.
  </p>

  <%- include('../partials/errors', { errors }) %>

  <div class="card mb-4">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">Entry</th>
            <th scope="col">Version</th>
            <th scope="col">Problems with version <%= list.version_number %></th>
          </tr>
        </thead>
        <tbody>
          <% oldEntries.forEach((e) => { %>
            <tr>
              <td><a href="/lists/<%= list.list_id %>/entries/<%= e.entry_id %>/edit">#<%= e.entry_id %></a></td>
              <td><span class="badge text-bg-warning">v<%= e.version_number %></span></td>
              <td>
                <% if (e.problems.length) { %>
                  <span class="text-danger"><%= e.problems.join('; ') %></span>
                <% } else { %>
                  <span class="text-success">Ready to update</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (droppedColumns.length) { %>
    <div class="alert alert-warning">
      <strong>These columns are no longer in the template and will be removed from updated entries:</strong>
      <%= droppedColumns.join(', ') %>
    </div>
  <% } %>

  <div class="row">
    <div class="col-lg-7">
      <form action="/lists/<%= list.list_id %>/entries/upgrade" method="POST" class="card">
        <div class="card-body">
          <% if (needsDefault.some(Boolean)) { %>
            <h2 class="h5">Default values</h2>
            <p class="text-body-secondary">Used for entries where this column is empty. Existing values are never replaced.</p>
            <% fields.forEach((field, i) => { %>
              <% if (needsDefault[i]) { %>
                <div class="mb-3">
                  <%- include('_input', { field, name: `f_${i}`, id: `f_${i}`, value: defaults[i], required: false, label: field.name }) %>
                </div>
              <% } %>
            <% }); %>
          <% } %>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Update entries</button>
            <a class="btn btn-outline-secondary" href="/lists/<%= list.list_id %>">Cancel</a>
          </div>
        </div>
      </form>
      <p class="form-text mt-2">Entries that still have problems stay on their old version. You can fix them one at a time with their Edit links.</p>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
