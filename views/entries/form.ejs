<%# Shared by "add entry" and "edit entry". `entry` is null when adding. %>
<% const heading = entry ? 'Edit Entry' : 'Add Entry'; %>
<%- include('../partials/header', { title: `${heading} | ${list.name}` }) %>

<%- include('../partials/pageHeader', {
  title: heading,
  subtitle: entry ? `Update this entry in ${list.name}.` : `Enter details for a new entry in ${list.name}.`,
  crumbs: [['/lists', 'Lists'], [`/lists/${list.list_id}`, list.name], ['', heading]],
}) %>

<% const errorFor = {}; errors.forEach((e) => { if (e.field && !errorFor[e.field]) errorFor[e.field] = e.message; }); %>

<div class="row">
  <div class="col-lg-8 col-xl-7">
    <% if (entry && entry.version_number < list.version_number) { %>
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
        <strong>This entry was saved under version <%= entry.version_number %> of the template.</strong>
        Saving it will check it against version <%= list.version_number %>'s rules.
      </div>
    <% } %>

    <% if (errors.length) { %>
      <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>
        <%= errors.length === 1 ? '1 field needs' : `${errors.length} fields need` %> fixing before this entry can be saved.
      </div>
    <% } %>

    <div class="card">
      <div class="card-body p-4">
        <form action="<%= entry ? `/lists/${list.list_id}/entries/${entry.entry_id}/edit` : `/lists/${list.list_id}/entries` %>" method="POST">
          <% fields.forEach((field, i) => { %>
            <div class="mb-4">
              <%- include('_input', {
                field, name: `f_${i}`, id: `f_${i}`, value: values[i],
                required: field.is_required && field.type !== 'boolean',
                label: field.name, star: field.is_required, error: errorFor[field.name] || null,
              }) %>
            </div>
          <% }); %>
          <div class="d-flex justify-content-between align-items-center border-top pt-3">
            <span class="small text-body-secondary"><span class="text-primary">*</span> required</span>
            <div class="d-flex gap-2">
              <a class="btn btn-outline-secondary" href="/lists/<%= list.list_id %>">Cancel</a>
              <button type="submit" class="btn btn-primary"><%= entry ? 'Save Changes' : 'Save Entry' %></button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
