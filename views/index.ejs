<%- include('partials/header', { title: 'Welcome' }) %>

<div class="card lf-hero border-0 mb-4">
  <div class="card-body p-4 p-md-5">
    <h1 class="display-5 fw-bold lh-sm mb-3" style="max-width: 36rem">Schema-Driven Lists, Done Right.</h1>
    <p class="lead text-body-secondary mb-4" style="max-width: 36rem">
      Design a template once, with the columns and rules you need, then create as many lists from it as you like.
      Every entry is checked against the template's rules before it's saved.
    </p>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-primary btn-lg" href="/signup">Get started</a>
      <a class="btn btn-outline-secondary btn-lg" href="/templates">Browse templates</a>
    </div>
  </div>
</div>

<div class="row g-3">
  <% [
       ['bi-stack', 'Design a template', 'Add checkboxes, text, dropdowns, dates, numbers, emails and links, and choose which ones are required.'],
       ['bi-list-ul', 'Create lists', 'Make lists from any template, like "Office Appointments" and "Home Visits" from one "Contact" template.'],
       ['bi-shield-check', 'Change safely', 'Edit a template any time. Old entries keep their rules until you choose to apply the new ones.'],
     ].forEach(([icon, heading, text]) => { %>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <i class="bi <%= icon %> fs-3 text-primary" aria-hidden="true"></i>
          <h2 class="h5 mt-2"><%= heading %></h2>
          <p class="text-body-secondary mb-0"><%= text %></p>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<%- include('partials/footer') %>
