PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=list_templates
# Set to true for cloud MySQL (Aiven etc.). DB_SSL_CA = path to the downloaded CA certificate.
DB_SSL=false
DB_SSL_CA=

# Session cookies (stored encrypted in MongoDB)
SESSION_SECRET=change-me
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/sessions
MONGO_CRYPTO_SECRET=change-me-too
